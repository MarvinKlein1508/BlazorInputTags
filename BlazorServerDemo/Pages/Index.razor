@page "/"
@inject DataSource dataSource
<PageTitle>InputTags - Blazor Server Demo</PageTitle>

<h3>Basic usage</h3>
<GenericInputTags TValue="Person" Value="dataSource.People" OnOptionsSearch="OnSearchPeopleAsync" />

@code {
    public List<string> Tags { get; set; } = new()
    {
        "Hello",
        "World"
    };

    private Task OnSearchPeopleAsync(OptionsSearchEventArgs<Person> e)
    {
        e.Items = dataSource.People.Where(p => p.FirstName.Contains(e.Text, StringComparison.OrdinalIgnoreCase));
        return Task.CompletedTask;
    }

}