@typeparam TValue
@inject IJSRuntime jsRuntime

<div class="blazor-tag-wrapper">
    <div class="blazor-tag-input-wrapper" tabindex="-1">
        <ul class="blazor-tag-list">
            @foreach (var item in Value)
            {
                <li class="blazor-tag">
                    @if (ItemTemplate is not null)
                    {
                        @ItemTemplate(item)
                    }
                    else
                    {
                        @item
                    }
                    <button type="button" @onclick="() => Value.Remove(item)"></button>
                </li>
            }
            <li class="blazor-tag-input"><input @ref="_reference" id="@_id" @onclick="OnInputClick" @onfocusout="OnInputFocusOutAsync" class="blazor-tag-input" type="text" placeholder="@Placeholder" @bind="Input" @oninput="InputHandlerAsync"></li>
        </ul>
    </div>

    <ul class="@GetResultListClass()">
        @foreach (var item in _searchResults)
        {
            <li class="@GetSearchResultClass(item)" @onclick="async () => await OnItemSelectedAsync(item)">
                @if (ItemTemplate is not null)
                {
                    @ItemTemplate(item)
                }
                else
                {
                    @item
                }
            </li>
        }
    </ul>
</div>


