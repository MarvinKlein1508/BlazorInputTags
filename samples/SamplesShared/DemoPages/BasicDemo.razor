@page "/basic-usage"
@using SamplesShared.SampleData
<PageTitle>Basic demo</PageTitle>

<h3>Allow any input</h3>
<GenericInputTags TValue="string" Value="Items" OnOptionsSearch="OnSearchTagAsync" Label="Tags" Placeholder="Enter tag" />

<h3>Allow objects</h3>
<GenericInputTags TValue="Person" Value="PersonItems" OnOptionsSearch="OnSearchPeopleAsync" Label="Contacts" Placeholder="Firstname" />

@code {
    public List<string> Items { get; set; } = [];
    public List<Person> PersonItems { get; set; } = [];

    protected override void OnInitialized()
    {
        PersonItems = new(DataSource.People);
    }

    private Task OnSearchTagAsync(OptionsSearchEventArgs<string> e)
    {
        e.Items = string.IsNullOrWhiteSpace(e.Text) ? [] : [e.Text];
        return Task.CompletedTask;
    }


    private Task OnSearchPeopleAsync(OptionsSearchEventArgs<Person> e)
    {
        e.Items = DataSource.People.Where(p => p.FirstName.Contains(e.Text, StringComparison.OrdinalIgnoreCase));
        return Task.CompletedTask;
    }

}