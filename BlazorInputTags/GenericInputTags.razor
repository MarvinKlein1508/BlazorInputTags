@typeparam TValue
@inject IJSRuntime jsRuntime


<div class="blazor-tag-wrapper" tabindex="-1">
    <ul class="blazor-tag-list">
        @foreach (var item in Value)
        {
            <li class="blazor-tag">@item <button type="button" @onclick="() => Value.Remove(item)">&times;</button></li>
        }
        <li class="blazor-tag-input"><input @ref="_reference" id="@_id" class="blazor-tag-input" type="text" placeholder="@Placeholder" @bind="Input" @oninput="InputHandlerAsync"></li>
    </ul>
</div>
@if (_showSearchResults)
{
    <ul class="blazor-tag-results">
        @foreach (var item in _items)
        {
            <li class="@GetSearchResultClass(item)" @onclick="async () => await OnItemSelectedAsync(item)">@item</li>
        }
    </ul>
}

